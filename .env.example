# ==============================================================
# AI Control Center — Environment Configuration Template
# Copy this file to .env for local overrides
# ==============================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development

# Database Configuration (Defaults to local SQLite if omitted)
# For cloud deployment with managed database, specify connection string:
# DATABASE_URL=postgresql://user:password@cloud-db-host:5432/ai_control_center
DATABASE_PATH=data/ai_control_center.db

# Security & Privacy Settings
# Toggle storing sanitized prompt previews in compliance logs (0 = False, 1 = True)
STORE_PROMPT_PREVIEWS=0

# Future Provider Integration Keys (Optional - disabled in initial prototype)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
